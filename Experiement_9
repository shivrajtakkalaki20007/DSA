#include <stdio.h>
#include <limits.h>
#define MAX_VERTICES 20
int main()
{
int graph[MAX_VERTICES][MAX_VERTICES];
int parent[MAX_VERTICES];
long long key[MAX_VERTICES];
int inMST[MAX_VERTICES] = {0};
int n, i, j, count;
int u;
long long minKey;
long long totalWeight = 0;
printf("Enter the number of vertices: ");
if (scanf("%d", &n) != 1 || n < 1 || n > MAX_VERTICES)
{
printf("Invalid number of vertices.\n");
return 1;
}
printf("Enter the adjacency matrix ");
printf("(0 indicates no edge):\n");
for (i = 0; i < n; i++)
{
for (j = 0; j < n; j++)
{
if (scanf("%d", &graph[i][j]) != 1 || graph[i][j] < 0)
{
printf("Invalid input.\n");
return 1;
}
}
}
/* Check the adjacency matrix */
for (i = 0; i < n; i++)
{
if (graph[i][i] != 0)
{
printf("Diagonal elements must be 0.\n");
return 1;
}
for (j=i+1; j<n; j++)
{
if (graph[i][j] != graph[j][i])
{
printf("Matrix must be symmetric.\n");
return 1;
}
}
}
/* Initialize key and parent arrays */
for (i = 0; i < n; i++)
{
key[i] = LLONG_MAX;
parent[i] = -1;
}
/* Start from the first vertex */
key[0] = 0;
/* Prim's Algorithm */
for (count = 0; count < n; count++)
{
minKey = LLONG_MAX;
u = -1;
/* Find minimum key vertex */
for (i = 0; i < n; i++)
{
if (!inMST[i] && key[i] < minKey)
{
u = i;
minKey = key[i];
}
}
/* Check for disconnected graph */
if (u == -1)
{
break;
}
inMST[u] = 1;
/* Update adjacent vertices */
for (j = 0; j < n; j++)
{
if (graph[u][j] > 0 && !inMST[j] && graph[u][j] < key[j])
{
key[j] = graph[u][j];
parent[j] = u;
}
}
}
/* Check graph connectivity */
for (i = 0; i < n; i++)
{
if (!inMST[i])
{
printf("\nGraph is disconnected.\n");
printf("MST cannot be generated.\n");
return 0;
}
}
/* Display Minimum Spanning Tree */
printf("\nMinimum Spanning Tree using Prim's Algorithm:\n");
printf("Edge\tWeight\n");
for (i = 1; i < n; i++)
{
printf("%d - %d\t%d\n", parent[i] + 1, i + 1, graph[parent[i]][i]);
totalWeight += graph[parent[i]][i];
}
printf("\nTotal Minimum Cost = %lld\n", totalWeight);
return 0;
}
